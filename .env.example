# Copy this file to .env and fill in the values. Never commit .env to GitHub.

# Pooled connection string from your Neon dashboard (host contains "-pooler").
# Used by the app while it is running.
DATABASE_URL="postgresql://USER:PASSWORD@ep-xxxx-pooler.REGION.aws.neon.tech/neondb?sslmode=require"

# Direct (non-pooled) connection string from Neon (host has NO "-pooler").
# Used by `prisma migrate`.
DIRECT_URL="postgresql://USER:PASSWORD@ep-xxxx.REGION.aws.neon.tech/neondb?sslmode=require"

# Secret used to sign login cookies. Must be at least 32 characters. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
SESSION_SECRET=""

# Initial passwords for the 5 accounts (at least 10 characters each). Used only by `npm run db:seed`.
# Usernames are: chair, vicechair, treasurer, secretary, volunteer.
# After seeding you can delete these lines; passwords can be changed in the app.
SEED_PASSWORD_CHAIR=""
SEED_PASSWORD_VICE_CHAIR=""
SEED_PASSWORD_TREASURER=""
SEED_PASSWORD_SECRETARY=""
SEED_PASSWORD_VOLUNTEER=""
